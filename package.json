{
  "name": "obsidian-ui-sketch",
  "version": "0.3.0",
  "private": true,
  "description": "Sketch web UI wireframes from human-readable YAML inside Obsidian notes. 44 components, AI-friendly structure, theme-adaptive.",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "gen:docs": "tsx scripts/gen-component-docs.ts",
    "gen:screenshots": "tsx scripts/gen-screenshots.ts",
    "preview": "tsx scripts/preview-sketch.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/parser": "^8.59.3",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "happy-dom": "^13.0.0",
    "obsidian": "^1.5.0",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "sanitize-html": "^2.17.4",
    "yaml": "^2.9.0",
    "zod": "^3.22.4"
  }
}
